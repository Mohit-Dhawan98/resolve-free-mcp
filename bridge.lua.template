-- Resolve bridge (free edition). Start once per session:
--   fu:RunScript("@@BRIDGE_DIR@@/bridge.lua")
local ROOT="@@BRIDGE_DIR@@/"
local n=1
while bmd.fileexists(ROOT.."outbox/res_"..n..".xml") do n=n+1 end
local idle=0
while true do
  local cmd=ROOT.."inbox/cmd_"..n..".lua"
  if bmd.fileexists(cmd) then
    fu:RunScript(cmd)
    local t=0
    while not bmd.fileexists(ROOT.."outbox/res_"..n..".xml") and t<600 do bmd.wait(0.1) t=t+1 end
    n=n+1 idle=0
  else
    bmd.wait(0.3) idle=idle+1
    if bmd.fileexists(ROOT.."STOP") then break end
  end
end
